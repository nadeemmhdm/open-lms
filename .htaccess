Options -Indexes
DirectoryIndex index.php

# InfinityFree free hosting may reject mod_headers directives in .htaccess.
# Security headers are emitted from includes/bootstrap.php instead.
<FilesMatch "^(\.env|composer\.(json|lock)|.*\.(sqlite|db|log|bak|sql))$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(?:config|database|storage|tests|app|includes)(?:/|$) - [F,L,NC]
